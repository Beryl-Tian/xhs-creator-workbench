{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/outline-backtest.schema.json",
  "title": "Outline Backtest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backtest_id", "project_id", "outline_id", "review_status", "verdict", "summary", "sources", "scorecard", "key_matches", "material_gaps", "deliberate_differences", "performance_context", "learning_candidates", "next_step", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "backtest_id": {"$ref": "common.schema.json#/$defs/id"},
    "project_id": {"$ref": "common.schema.json#/$defs/id"},
    "outline_id": {"$ref": "common.schema.json#/$defs/id"},
    "review_status": {"enum": ["pending_review", "confirmed", "rejected"]},
    "verdict": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["label", "reference"], "properties": {"label": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}, "note": {"type": ["string", "null"]}}}},
    "scorecard": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["dimension", "generated", "historical", "assessment"], "properties": {"dimension": {"type": "string", "minLength": 1}, "generated": {"type": "string", "minLength": 1}, "historical": {"type": "string", "minLength": 1}, "assessment": {"type": "string", "minLength": 1}}}},
    "key_matches": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "material_gaps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["priority", "gap", "evidence", "recommendation"], "properties": {"priority": {"enum": ["high", "medium", "low"]}, "gap": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "minLength": 1}}}},
    "deliberate_differences": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "performance_context": {"type": "object", "additionalProperties": false, "required": ["captured_after_hours", "metrics", "reference_benchmark", "interpretation"], "properties": {"captured_after_hours": {"type": "number", "minimum": 0}, "metrics": {"type": "object", "additionalProperties": {"type": "number"}}, "reference_benchmark": {"type": "array", "items": {"type": "string", "minLength": 1}}, "interpretation": {"type": "string", "minLength": 1}}},
    "learning_candidates": {"type": "object", "additionalProperties": false, "required": ["keep", "change", "do_not_learn"], "properties": {"keep": {"type": "array", "items": {"type": "string", "minLength": 1}}, "change": {"type": "array", "items": {"type": "string", "minLength": 1}}, "do_not_learn": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "next_step": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
