{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/content-routes-candidate.schema.json",
  "title": "Content Routes Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routes"],
  "properties": {
    "schema_version": {"const": 1},
    "rationale": {"type": ["string", "null"]},
    "routes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["premise", "conflict", "scene", "emotional_arc", "product_role", "creator_fit", "brief_coverage", "risks", "recommended"],
      "properties": {
        "premise": {"type": "string", "minLength": 1}, "conflict": {"type": "string", "minLength": 1}, "scene": {"type": "string", "minLength": 1},
        "emotional_arc": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "product_role": {"type": "string", "minLength": 1},
        "creator_fit": {"type": "object", "additionalProperties": false, "required": ["reason", "evidence_refs"], "properties": {"reason": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/id"}}}},
        "brief_coverage": {"type": "array", "items": {"type": "string"}}, "risks": {"type": "array", "items": {"type": "string"}}, "recommended": {"type": "boolean"}
      }
    }}
  }
}
