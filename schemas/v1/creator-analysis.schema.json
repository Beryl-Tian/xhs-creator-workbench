{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/creator-analysis.schema.json",
  "title": "Deterministic Creator Analysis Substrate",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_count", "quality", "distillation_gate", "confidence_band", "metrics", "performance", "content_types", "cadence", "top_tags", "topic_candidates", "content_archetypes", "development_trend", "longitudinal", "top_notes", "segments", "title_patterns", "title_statistics", "opening_patterns", "ending_patterns", "cta_patterns", "content_structure", "emoji_text_layout", "opinion_candidates", "distinctive_term_candidates", "audience_signals", "limitations"],
  "properties": {
    "sample_count": {"type": "integer", "minimum": 1},
    "quality": {"type": "object"},
    "distillation_gate": {"type": "object"},
    "confidence_band": {"enum": ["low", "medium", "high"]},
    "metrics": {"type": "object"},
    "performance": {"type": "object"},
    "content_types": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "cadence": {"type": "object"},
    "top_tags": {"type": "array", "items": {"type": "object"}},
    "topic_candidates": {"type": "array", "items": {"type": "object"}},
    "content_archetypes": {"type": "object"},
    "development_trend": {"type": ["object", "null"]},
    "longitudinal": {"type": "object"},
    "top_notes": {"type": "array", "items": {"type": "object"}},
    "segments": {"type": "object"},
    "title_patterns": {"type": "object"},
    "title_statistics": {"type": "object"},
    "opening_patterns": {"type": "object"},
    "ending_patterns": {"type": "object"},
    "cta_patterns": {"type": "object"},
    "content_structure": {"type": "object"},
    "emoji_text_layout": {"type": "object"},
    "opinion_candidates": {"type": "array", "items": {"type": "object"}},
    "distinctive_term_candidates": {"type": "array", "items": {"type": "object"}},
    "audience_signals": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
