{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/learning-review.schema.json",
  "title": "Learning Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "project_id", "candidate_id", "decision", "reviewed_at"],
  "properties": {
    "schema_version": {"const": 1}, "review_id": {"$ref": "common.schema.json#/$defs/id"},
    "project_id": {"$ref": "common.schema.json#/$defs/id"}, "candidate_id": {"$ref": "common.schema.json#/$defs/id"},
    "decision": {"enum": ["accepted", "rejected"]}, "note": {"type": ["string", "null"]},
    "reviewed_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
