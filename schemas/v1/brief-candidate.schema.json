{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/brief-candidate.schema.json",
  "title": "Brief Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brand", "product", "deliverable", "facts", "inferences", "open_questions"],
  "properties": {
    "schema_version": {"const": 1},
    "brand": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "deliverable": {"type": "string", "minLength": 1},
    "audience": {"type": ["string", "null"]},
    "pain_points": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "selling_points": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "must_include": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forbidden": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scene": {"type": ["string", "null"]},
    "campaign": {"type": ["string", "null"]},
    "deadline": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "facts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "inferences": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["statement", "confidence"], "properties": {"statement": {"type": "string", "minLength": 1}, "confidence": {"$ref": "common.schema.json#/$defs/confidence"}}}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
