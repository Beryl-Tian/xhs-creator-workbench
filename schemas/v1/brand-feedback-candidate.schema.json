{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/brand-feedback-candidate.schema.json",
  "title": "Brand Feedback Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["location", "request", "type", "understanding"], "properties": {
      "location": {"type": ["string", "null"]}, "request": {"type": "string", "minLength": 1},
      "type": {"enum": ["structure", "selling_point", "wording", "compliance", "creator_fit", "other"]},
      "understanding": {"enum": ["clear", "ambiguous", "creator_conflict"]}
    }} }
  }
}
