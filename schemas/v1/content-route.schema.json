{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/content-route.schema.json",
  "title": "Content Route",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_id", "project_id", "premise", "conflict", "scene", "emotional_arc", "product_role", "creator_fit", "brief_coverage", "risks", "recommended"],
  "properties": {
    "schema_version": {"const": 1},
    "route_id": {"$ref": "common.schema.json#/$defs/id"},
    "project_id": {"$ref": "common.schema.json#/$defs/id"},
    "premise": {"type": "string", "minLength": 1},
    "conflict": {"type": "string", "minLength": 1},
    "scene": {"type": "string", "minLength": 1},
    "emotional_arc": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "product_role": {"type": "string", "minLength": 1},
    "creator_fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "evidence_refs"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}}
      }
    },
    "brief_coverage": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "recommended": {"type": "boolean"}
  }
}
