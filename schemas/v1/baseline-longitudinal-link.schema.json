{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/baseline-longitudinal-link.schema.json",
  "title": "Creator Baseline Longitudinal Analysis Link",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "link_id", "creator_id", "source_baseline_id", "result_baseline_id", "longitudinal_run_id", "sample_count", "dated_note_count", "attached_at"],
  "properties": {
    "schema_version": {"const": 1},
    "link_id": {"$ref": "common.schema.json#/$defs/id"},
    "creator_id": {"$ref": "common.schema.json#/$defs/id"},
    "source_baseline_id": {"$ref": "common.schema.json#/$defs/id"},
    "result_baseline_id": {"$ref": "common.schema.json#/$defs/id"},
    "longitudinal_run_id": {"$ref": "common.schema.json#/$defs/id"},
    "sample_count": {"type": "integer", "minimum": 1},
    "dated_note_count": {"type": "integer", "minimum": 1},
    "attached_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
