{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/route-selection.schema.json",
  "title": "Route Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_id", "project_id", "route_id", "selected_at"],
  "properties": {
    "schema_version": {"const": 1},
    "selection_id": {"$ref": "common.schema.json#/$defs/id"},
    "project_id": {"$ref": "common.schema.json#/$defs/id"},
    "route_id": {"$ref": "common.schema.json#/$defs/id"},
    "note": {"type": ["string", "null"]},
    "selected_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
