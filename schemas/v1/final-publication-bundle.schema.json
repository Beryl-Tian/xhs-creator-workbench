{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/final-publication-bundle.schema.json",
  "title": "Final Publication Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "project_id", "completeness", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"$ref": "common.schema.json#/$defs/id"},
    "project_id": {"$ref": "common.schema.json#/$defs/id"},
    "oral_script_source": {"oneOf": [{"$ref": "common.schema.json#/$defs/file_ref"}, {"type": "null"}]},
    "oral_script": {"type": ["string", "null"]},
    "oral_script_warnings": {"type": "array", "items": {"type": "string"}},
    "published_copy_source": {"oneOf": [{"$ref": "common.schema.json#/$defs/file_ref"}, {"type": "null"}]},
    "published_copy_screenshot_source": {"oneOf": [{"$ref": "common.schema.json#/$defs/file_ref"}, {"type": "null"}]},
    "published_copy_extracted_text": {"type": ["string", "null"]},
    "published_copy_warnings": {"type": "array", "items": {"type": "string"}},
    "published_title": {"type": ["string", "null"]},
    "published_body": {"type": ["string", "null"]},
    "published_tags": {"type": "array", "items": {"type": "string"}},
    "approved_outline_diff": {"type": ["object", "null"]},
    "approved_copy_diff": {"type": ["object", "null"]},
    "published_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "published_url": {"oneOf": [{"type": "string", "format": "uri", "pattern": "^https?://"}, {"type": "null"}]},
    "completeness": {"enum": ["partial", "complete"]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"completeness": {"const": "complete"}}},
      "then": {
        "required": ["oral_script_source", "oral_script", "published_copy_source", "published_copy_extracted_text", "published_title", "published_body", "published_tags"],
        "properties": {
          "oral_script_source": {"$ref": "common.schema.json#/$defs/file_ref"},
          "oral_script": {"type": "string", "minLength": 1},
          "published_copy_source": {"$ref": "common.schema.json#/$defs/file_ref"},
          "published_copy_extracted_text": {"type": "string", "minLength": 1},
          "published_title": {"type": "string", "minLength": 1},
          "published_body": {"type": "string", "minLength": 1},
          "published_tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  ]
}
