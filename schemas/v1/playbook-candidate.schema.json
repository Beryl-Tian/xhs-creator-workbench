{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/playbook-candidate.schema.json",
  "title": "Creator Playbook Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "creator_id", "baseline_id", "core_thesis", "current_content_axes", "legacy_capabilities", "route_patterns", "title_formulas", "body_templates", "language_kit", "commercial_rules", "audience_translation", "review_checklist", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "creator_id": {"$ref": "common.schema.json#/$defs/id"},
    "baseline_id": {"$ref": "common.schema.json#/$defs/id"},
    "core_thesis": {"$ref": "#/$defs/claim_block"},
    "current_content_axes": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"$ref": "#/$defs/axis"}},
    "legacy_capabilities": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/legacy"}},
    "route_patterns": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/route"}},
    "title_formulas": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/formula"}},
    "body_templates": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"$ref": "#/$defs/template"}},
    "language_kit": {"$ref": "#/$defs/language"},
    "commercial_rules": {"$ref": "#/$defs/commercial"},
    "audience_translation": {"$ref": "#/$defs/audience"},
    "review_checklist": {"$ref": "#/$defs/checklist"},
    "limitations": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "claim_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "claim_block": {"type": "object", "additionalProperties": false, "required": ["statement", "claim_ids"], "properties": {"statement": {"type": "string", "minLength": 1}, "claim_ids": {"$ref": "#/$defs/claim_ids"}}},
    "axis": {"type": "object", "additionalProperties": false, "required": ["name", "role", "use_when", "claim_ids"], "properties": {"name": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "use_when": {"type": "string", "minLength": 1}, "claim_ids": {"$ref": "#/$defs/claim_ids"}}},
    "legacy": {"type": "object", "additionalProperties": false, "required": ["name", "current_role", "evidence_refs"], "properties": {"name": {"type": "string", "minLength": 1}, "current_role": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/example"}}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["name", "use_when", "premise", "structure", "product_entry", "claim_ids"], "properties": {"name": {"type": "string", "minLength": 1}, "use_when": {"type": "string", "minLength": 1}, "premise": {"type": "string", "minLength": 1}, "structure": {"type": "array", "minItems": 3, "maxItems": 7, "items": {"type": "string", "minLength": 1}}, "product_entry": {"type": "string", "minLength": 1}, "claim_ids": {"$ref": "#/$defs/claim_ids"}}},
    "formula": {"type": "object", "additionalProperties": false, "required": ["formula", "use_when", "examples", "claim_ids"], "properties": {"formula": {"type": "string", "minLength": 1}, "use_when": {"type": "string", "minLength": 1}, "examples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/example"}}, "claim_ids": {"$ref": "#/$defs/claim_ids"}}},
    "template": {"type": "object", "additionalProperties": false, "required": ["name", "use_when", "steps", "claim_ids"], "properties": {"name": {"type": "string", "minLength": 1}, "use_when": {"type": "string", "minLength": 1}, "steps": {"type": "array", "minItems": 3, "maxItems": 7, "items": {"type": "string", "minLength": 1}}, "claim_ids": {"$ref": "#/$defs/claim_ids"}}},
    "example": {"type": "object", "additionalProperties": false, "required": ["text", "evidence_id"], "properties": {"text": {"type": "string", "minLength": 1}, "evidence_id": {"$ref": "common.schema.json#/$defs/id"}}},
    "language": {"type": "object", "additionalProperties": false, "required": ["keep", "avoid", "cta", "phrase_examples"], "properties": {"keep": {"$ref": "#/$defs/strings"}, "avoid": {"$ref": "#/$defs/strings"}, "cta": {"$ref": "#/$defs/strings"}, "phrase_examples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/example"}}}},
    "commercial": {"type": "object", "additionalProperties": false, "required": ["default_path", "exception_path", "checklist", "claim_ids"], "properties": {"default_path": {"$ref": "#/$defs/strings"}, "exception_path": {"$ref": "#/$defs/strings"}, "checklist": {"$ref": "#/$defs/strings"}, "claim_ids": {"$ref": "#/$defs/claim_ids"}}},
    "audience": {"type": "object", "additionalProperties": false, "required": ["observed_audience", "desired_audience", "content_signals", "claim_ids"], "properties": {"observed_audience": {"type": "string", "minLength": 1}, "desired_audience": {"type": "string", "minLength": 1}, "content_signals": {"$ref": "#/$defs/strings"}, "claim_ids": {"$ref": "#/$defs/claim_ids"}}},
    "checklist": {"type": "array", "minItems": 5, "maxItems": 12, "items": {"type": "string", "minLength": 1}}
  }
}
