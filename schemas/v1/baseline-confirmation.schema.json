{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/baseline-confirmation.schema.json",
  "title": "Baseline Confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "confirmation_id", "baseline_id", "creator_id", "decision", "confirmed_at"],
  "properties": {
    "schema_version": {"const": 1},
    "confirmation_id": {"$ref": "common.schema.json#/$defs/id"},
    "baseline_id": {"$ref": "common.schema.json#/$defs/id"},
    "creator_id": {"$ref": "common.schema.json#/$defs/id"},
    "decision": {"const": "confirmed"},
    "note": {"type": ["string", "null"]},
    "confirmed_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
