{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/archive-candidate.schema.json",
  "title": "Final Archive Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "published_copy", "approved_outline_diff", "approved_copy_diff", "learning_candidates"],
  "$defs": {
    "change": {"type": "object", "additionalProperties": false, "required": ["type", "description", "likely_source", "confidence"], "properties": {"type": {"enum": ["added", "removed", "reordered", "weakened", "strengthened"]}, "description": {"type": "string", "minLength": 1}, "approved_ref": {"type": ["string", "null"]}, "final_ref": {"type": ["string", "null"]}, "likely_source": {"enum": ["brand_review", "creator_creation", "shoot_execution", "unknown"]}, "confidence": {"$ref": "common.schema.json#/$defs/confidence"}}},
    "diff": {"type": "object", "additionalProperties": false, "required": ["summary", "changes"], "properties": {"summary": {"type": "string"}, "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}}}}
  },
  "properties": {
    "schema_version": {"const": 1},
    "published_copy": {"type": "object", "additionalProperties": false, "required": ["title", "body", "tags"], "properties": {"title": {"type": "string", "minLength": 1}, "body": {"type": "string", "minLength": 1}, "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "approved_outline_diff": {"$ref": "#/$defs/diff"},
    "approved_copy_diff": {"$ref": "#/$defs/diff"},
    "learning_candidates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["scope", "statement", "reason", "evidence_refs", "confidence"], "properties": {"scope": {"enum": ["project_only", "brand", "category", "commercial", "organic", "global"]}, "statement": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/id"}}, "confidence": {"$ref": "common.schema.json#/$defs/confidence"}}}}
  }
}
