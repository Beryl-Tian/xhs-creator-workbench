{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/baseline.schema.json",
  "title": "Creator Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_id", "creator_id", "source_run_id", "version", "review_status", "sample_window", "summary", "sections", "claims", "missing_dimensions", "human_review_questions", "limitations", "validation_notes", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "baseline_id": {"$ref": "common.schema.json#/$defs/id"},
    "creator_id": {"$ref": "common.schema.json#/$defs/id"},
    "source_run_id": {"$ref": "common.schema.json#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "review_status": {"enum": ["pending_confirmation", "confirmed", "rejected", "superseded"]},
    "confirmed_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "sample_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "sample_count", "oldest_published_at", "newest_published_at"],
      "properties": {
        "captured_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "sample_count": {"type": "integer", "minimum": 1},
        "oldest_published_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "newest_published_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_line_positioning", "audience", "content_identity", "commercial_identity"],
      "properties": {
        "one_line_positioning": {"$ref": "#/$defs/summary_item"},
        "audience": {"$ref": "#/$defs/summary_item"},
        "content_identity": {"$ref": "#/$defs/summary_item"},
        "commercial_identity": {"$ref": "#/$defs/summary_item"}
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positioning", "audience", "cognition", "strategy", "organic", "commercial", "voice", "visual", "guardrail"],
      "properties": {
        "positioning": {"$ref": "#/$defs/claim_ids"},
        "audience": {"$ref": "#/$defs/claim_ids"},
        "cognition": {"$ref": "#/$defs/claim_ids"},
        "strategy": {"$ref": "#/$defs/claim_ids"},
        "organic": {"$ref": "#/$defs/claim_ids"},
        "commercial": {"$ref": "#/$defs/claim_ids"},
        "voice": {"$ref": "#/$defs/claim_ids"},
        "visual": {"$ref": "#/$defs/claim_ids"},
        "guardrail": {"$ref": "#/$defs/claim_ids"}
      }
    },
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "missing_dimensions": {"$ref": "#/$defs/nonempty_strings"},
    "human_review_questions": {"$ref": "#/$defs/nonempty_strings"},
    "human_context": {"type": "array", "items": {"$ref": "#/$defs/human_context"}},
    "source_baseline_id": {"$ref": "common.schema.json#/$defs/id"},
    "source_calibration_id": {"$ref": "common.schema.json#/$defs/id"},
    "longitudinal_run_id": {"$ref": "common.schema.json#/$defs/id"},
    "source_longitudinal_link_id": {"$ref": "common.schema.json#/$defs/id"},
    "limitations": {"$ref": "#/$defs/nonempty_strings"},
    "validation_notes": {"$ref": "#/$defs/nonempty_strings"},
    "source_candidate_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "$defs": {
    "claim_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}},
    "nonempty_strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "summary_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence_refs", "limitations"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}},
        "limitations": {"$ref": "#/$defs/nonempty_strings"}
      }
    },
    "human_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "context_type", "statement", "source", "status", "applicable_to", "recorded_at"],
      "properties": {
        "context_id": {"$ref": "common.schema.json#/$defs/id"},
        "context_type": {"enum": ["desired_positioning", "target_audience", "commercial_guardrail"]},
        "statement": {"type": "string", "minLength": 1},
        "source": {"const": "creator_team"},
        "status": {"const": "confirmed"},
        "applicable_to": {"type": "array", "items": {"enum": ["creator_understanding", "topic_selection", "commercial_route", "commercial_outline", "publication_copy", "review", "archive_learning"]}},
        "recorded_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "category", "finding_type", "statement", "epistemic_status", "confidence", "evidence_refs", "counter_evidence_refs", "applicable_to", "limitations"],
      "properties": {
        "claim_id": {"$ref": "common.schema.json#/$defs/id"},
        "category": {"enum": ["positioning", "audience", "cognition", "strategy", "organic", "commercial", "voice", "visual", "guardrail"]},
        "finding_type": {"enum": ["positioning", "audience_need", "content_pillar", "core_belief", "viewpoint_tension", "mental_model", "value_stance", "content_series", "topical_strategy", "operating_hypothesis", "title_formula", "opening_pattern", "body_structure", "emotional_arc", "language_dna", "cta_pattern", "tag_strategy", "publishing_cadence", "commercial_integration", "commercial_difference", "must_keep", "avoid", "unknown_visual"]},
        "statement": {"type": "string", "minLength": 1},
        "epistemic_status": {"enum": ["observed", "inferred", "confirmed", "rejected"]},
        "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}},
        "counter_evidence_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}},
        "applicable_to": {"type": "array", "items": {"enum": ["creator_understanding", "topic_selection", "commercial_route", "commercial_outline", "publication_copy", "review", "archive_learning"]}},
        "limitations": {"$ref": "#/$defs/nonempty_strings"}
      }
    }
  }
}
