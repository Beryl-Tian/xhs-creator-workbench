{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/publication-copy-candidate.schema.json",
  "title": "Publication Copy Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title_options", "body", "tags", "brief_coverage", "risks"],
  "properties": {
    "schema_version": {"const": 1},
    "title_options": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "body": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "brief_coverage": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
