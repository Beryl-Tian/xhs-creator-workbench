{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/project.schema.json",
  "title": "Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "creator_id", "title", "brand", "product", "baseline_id", "workflow_state", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"$ref": "common.schema.json#/$defs/id"},
    "creator_id": {"$ref": "common.schema.json#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "brand": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "baseline_id": {"$ref": "common.schema.json#/$defs/id"},
    "playbook_id": {"$ref": "common.schema.json#/$defs/id"},
    "backtest_excluded_evidence_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/id"},
      "uniqueItems": true
    },
    "workflow_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outline", "publication_copy", "creator_production", "publication", "archive"],
      "properties": {
        "outline": {"enum": ["not_started", "drafting", "brand_review", "approved"]},
        "publication_copy": {"enum": ["not_started", "drafting", "brand_review", "approved"]},
        "creator_production": {"enum": ["not_started", "in_progress", "complete"]},
        "publication": {"enum": ["not_published", "published"]},
        "archive": {"enum": ["incomplete", "complete"]}
      }
    },
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
