{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xhs-workbench.local/schemas/v1/outline.schema.json",
  "title": "Outline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outline_id", "project_id", "route_id", "version", "working_titles", "hooks", "estimated_duration_seconds", "sections", "brief_coverage", "creator_fit_checks", "assumptions", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "outline_id": {"$ref": "common.schema.json#/$defs/id"},
    "project_id": {"$ref": "common.schema.json#/$defs/id"},
    "route_id": {"$ref": "common.schema.json#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "working_titles": {"type": "array", "items": {"type": "string"}},
    "hooks": {"type": "array", "items": {"type": "string"}},
    "target_duration_seconds": {"type": "integer", "minimum": 1},
    "estimated_duration_seconds": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": {"min": {"type": "integer", "minimum": 1}, "max": {"type": "integer", "minimum": 1}}
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "label", "duration_seconds", "goal", "shots", "rough_voiceover", "on_screen_text", "brand_presence"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "minLength": 1},
          "duration_seconds": {
            "type": "object", "additionalProperties": false, "required": ["min", "max"],
            "properties": {"min": {"type": "integer", "minimum": 1}, "max": {"type": "integer", "minimum": 1}}
          },
          "goal": {"type": "string", "minLength": 1},
          "shots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "rough_voiceover": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "on_screen_text": {"type": "array", "items": {"type": "string"}},
          "brand_presence": {"type": ["string", "null"]}
        }
      }
    },
    "shot_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_no", "section_order", "duration_seconds", "scene", "framing", "rough_voiceover", "on_screen_text", "audio_or_notes", "brand_presence"],
        "properties": {
          "shot_no": {"type": "integer", "minimum": 1},
          "section_order": {"type": "integer", "minimum": 1},
          "duration_seconds": {"type": "integer", "minimum": 1},
          "scene": {"type": "string", "minLength": 1},
          "framing": {"type": "string", "minLength": 1},
          "rough_voiceover": {"type": "string", "minLength": 1},
          "on_screen_text": {"type": "array", "items": {"type": "string"}},
          "audio_or_notes": {"type": "array", "items": {"type": "string"}},
          "brand_presence": {"type": ["string", "null"]}
        }
      }
    },
    "brief_coverage": {"type": "array", "items": {"type": "string"}},
    "creator_fit_checks": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "created_from_feedback_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
    "risks": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
